<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.100" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis.NetAnalyzers" HintPath="$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)/analyzers/dotnet/Microsoft.CodeAnalysis.NetAnalyzers.dll" Private="true" />
  </ItemGroup>

  <ItemGroup>
    <None Include="CodeMetricsConfig.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
