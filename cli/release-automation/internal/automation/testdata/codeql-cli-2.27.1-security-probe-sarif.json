{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "semanticVersion": "2.27.1"
        }
      },
      "results": [
        {
          "ruleId": "cs/command-line-injection",
          "message": {
            "text": "This command line depends on a [user-provided value](1)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Packages/src/CodeQLSecurityProbe.cs"
                }
              }
            }
          ]
        }
      ],
      "properties": {
        "probeQueryPack": "codeql/csharp-queries@1.10.0",
        "probeQuerySuite": "security-extended"
      }
    }
  ]
}
