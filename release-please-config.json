{
  "packages": {
    ".": {
      "release-type": "go",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "exclude-paths": [
        "cli"
      ],
      "changelog-path": "Packages/src/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "Packages/src/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "Packages/src/project-runner-pin.json",
          "jsonpath": "$.packageVersion"
        },
        {
          "type": "json",
          "path": ".uloop/project-runner-pin.json",
          "jsonpath": "$.packageVersion"
        }
      ]
    },
    "cli": {
      "component": "uloop-project-runner",
      "release-type": "go",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "include-v-in-tag": true,
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "internal/tools/default-tools.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "contract.json",
          "jsonpath": "$.projectRunnerVersion"
        },
        {
          "type": "json",
          "path": "/Packages/src/project-runner-pin.json",
          "jsonpath": "$.projectRunnerVersion"
        },
        {
          "type": "json",
          "path": "/.uloop/project-runner-pin.json",
          "jsonpath": "$.projectRunnerVersion"
        }
      ]
    }
  }
}
