{
  "packages": {
    ".": {
      "release-type": "go",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "exclude-paths": [
        "Packages/src/Cli~"
      ],
      "changelog-path": "Packages/src/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "Packages/src/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "Packages/src/Cli~": {
      "component": "cli",
      "release-type": "go",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "include-v-in-tag": true,
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "internal/tools/default-tools.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "contract.json",
          "jsonpath": "$.cliVersion"
        }
      ]
    }
  }
}
