      "prerelease-type": "beta",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "cli/dispatcher": {
      "component": "dispatcher",
      "release-type": "go",
