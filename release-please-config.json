{
  "packages": {
    ".": {
      "release-type": "go",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "changelog-path": "Packages/src/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "Packages/src/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "Packages/src/Cli~/Core~/internal/presentation/cli/default-tools.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "Packages/src/Cli~/Core~/contract.json",
          "jsonpath": "$.coreVersion"
        },
        {
          "type": "json",
          "path": "Packages/src/Cli~/Dispatcher~/contract.json",
          "jsonpath": "$.dispatcherVersion"
        }
      ]
    }
  }
}
