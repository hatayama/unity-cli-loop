{
  "packages": {
    ".": {
      "release-type": "go",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "exclude-paths": [
        "cli"
      ],
      "changelog-path": "Packages/src/CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "Packages/src/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "cli": {
      "component": "cli",
      "release-as": "3.0.0-beta.31",
      "release-type": "go",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "include-v-in-tag": true,
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "internal/tools/default-tools.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "contract.json",
          "jsonpath": "$.cliVersion"
        }
      ]
    }
  }
}
